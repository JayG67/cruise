{
  "name": "cruise",
  "version": "1.0.0",
  "description": "mock cruise travel agent application to demonstrate coding ability",
  "license": "ISC",
  "author": "Jay Gallagher",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start:prod": "node index.js",
    "start": "docker compose up -d && DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/cruise node --watch index.js",
    "start:ci": "node index.js",
    "unitTests": "jest tests/unit",
    "integrationTests": "jest --config jest.integration.config.js --runInBand",
    "test": "npm run unitTests && npm run integrationTests && npm run uiTests",
    "test:all": "npm run test && npm run perf:smoke:local && npm run lighthouse:ci:local",
    "coverage": "jest --coverage --runInBand",
    "unitTestsWatch": "jest tests/unit --watchAll",
    "uiTests:open": "start-server-and-test start http://localhost:8000 \"npm run cypress:open\"",
    "cypress:open": "cypress open --browser chrome",
    "cypress:run": "cypress run",
    "uiTests": "start-server-and-test start http://localhost:8000 cypress:run",
    "uiTests:ci": "start-server-and-test start:ci http://localhost:8000 cypress:run",
    "db:verify:test": "node scripts/verify-test-db-connection.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "perf:smoke": "k6 run performance/cruise-api-smoke.js",
    "perf:smoke:local": "start-server-and-test start http://localhost:8000 perf:smoke",
    "perf:smoke:ci": "start-server-and-test start:ci http://localhost:8000 perf:smoke",
    "lighthouse:mobile": "lighthouse http://localhost:8000 --form-factor=mobile --screenEmulation.mobile=true --only-categories=performance,accessibility,best-practices,seo --chrome-flags=\"--headless\" --output html --output json --output-path ./lighthouse-report --quiet --no-enable-error-reporting",
    "lighthouse:mobile:local": "start-server-and-test start http://localhost:8000 lighthouse:mobile",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:ci:local": "start-server-and-test start http://localhost:8000 lighthouse:ci"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "cypress": "^15.14.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.3.0",
    "start-server-and-test": "^3.0.2",
    "supertest": "^7.2.2",
    "trx": "^1.5.0",
    "lighthouse": "^12.8.2",
    "@lhci/cli": "^0.15.1"
  }
}
