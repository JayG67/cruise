{
  "name": "cruise",
  "version": "1.0.0",
  "description": "mock cruise travel agent application to demonstrate coding ability",
  "license": "ISC",
  "author": "Jay Gallagher",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start:prod": "node index.js",
    "start": "docker compose up -d && SUPPRESS_DB_LOGS=true DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/cruise node --watch index.js",
    "start:ci": "SUPPRESS_DB_LOGS=true node index.js",
    "unitTests": "NODE_NO_WARNINGS=1 jest tests/unit",
    "integrationTests": "npm run db:test:ready && NODE_NO_WARNINGS=1 jest --config jest.integration.config.js --runInBand --detectOpenHandles",
    "test": "npm run unitTests && npm run coverage && npm run uiTests",
    "test:all": "npm run test && npm run playwright:mobile:local && npm run playwright:responsive:local && npm run perf:smoke:local && npm run lighthouse:ci:local",
    "coverage": "npm run db:test:ready && NODE_NO_WARNINGS=1 jest --coverage --runInBand",
    "unitTestsWatch": "jest tests/unit --watchAll",
    "uiTests:open": "start-server-and-test start http://localhost:8000 \"npm run cypress:open\"",
    "cypress:open": "cypress open --browser chrome",
    "cypress:run": "cypress run",
    "uiTests": "start-server-and-test start http://localhost:8000 cypress:run",
    "uiTests:ci": "start-server-and-test start:ci http://localhost:8000 cypress:run",
    "db:verify:test": "node scripts/verify-test-db-connection.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "perf:smoke": "k6 run performance/cruise-api-smoke.js",
    "perf:smoke:local": "start-server-and-test start http://localhost:8000 perf:smoke",
    "perf:smoke:ci": "start-server-and-test start:ci http://localhost:8000 perf:smoke",
    "lighthouse:mobile": "lighthouse http://localhost:8000 --form-factor=mobile --screenEmulation.mobile=true --only-categories=performance,accessibility,best-practices,seo --chrome-flags=\"--headless\" --output html --output json --output-path ./lighthouse-report --quiet --no-enable-error-reporting",
    "lighthouse:mobile:local": "start-server-and-test start http://localhost:8000 lighthouse:mobile",
    "lighthouse:ci": "lhci autorun --config=.github/lighthouserc.json",
    "lighthouse:ci:local": "start-server-and-test start http://localhost:8000 lighthouse:ci",
    "lighthouse:ci:ci": "start-server-and-test start:ci http://localhost:8000 lighthouse:ci",
    "lighthouse:prepare-pages": "node scripts/prepare-lighthouse-pages.js",
    "quality:prepare-dashboard": "node scripts/prepare-quality-dashboard.js",
    "coverage:ci": "jest --coverage --runInBand --coverageReporters=json-summary --coverageReporters=lcov --coverageReporters=text",
    "coverage:prepare-pages": "node scripts/prepare-coverage-pages.js",
    "playwright:mobile": "playwright test --config=playwright.mobile.config.js",
    "playwright:mobile:local": "start-server-and-test start http://localhost:8000 playwright:mobile",
    "playwright:mobile:ci": "start-server-and-test start:ci http://localhost:8000 playwright:mobile",
    "playwright:responsive": "playwright test --config=playwright.responsive.config.js",
    "playwright:responsive:local": "start-server-and-test start http://localhost:8000 playwright:responsive",
    "playwright:responsive:ci": "start-server-and-test start:ci http://localhost:8000 playwright:responsive",
    "repo:hygiene": "node scripts/verify-repo-hygiene.js",
    "portfolio:audit": "npm run repo:hygiene && npm run test:all",
    "react:dev": "vite --config frontend/react/vite.config.js --host 0.0.0.0 --port 5173",
    "react:build": "vite build --config frontend/react/vite.config.js",
    "react:preview": "vite preview --config frontend/react/vite.config.js --host 0.0.0.0 --port 4173",
    "react:scaffold:audit": "node scripts/verify-react-migration-scaffold.js",
    "db:test:ready": "docker compose up -d && node scripts/wait-for-test-db.js",
    "react:stage1:audit": "node scripts/verify-react-stage-1.js",
    "react:migration:audit": "npm run react:scaffold:audit && npm run react:stage1:audit && npm run react:stage2:audit && npm run react:stage3:audit && npm run react:stage4:audit && npm run react:stage5:audit && npm run react:stage6:audit && npm run react:stage7:audit && npm run react:stage8:audit && npm run react:stage9:audit && npm run react:stage10:audit && npm run react:stage11:audit && npm run react:stage12:audit && npm run react:stage13:audit && npm run react:stage14:audit && npm run react:stage15:audit && npm run react:stage16:audit && npm run react:stage17:audit && npm run react:stage18:audit && npm run react:stage19:audit && npm run react:stage20:audit && npm run react:stage21:audit",
    "react:stage2:audit": "node scripts/verify-react-stage-2.js",
    "react:stage3:audit": "node scripts/verify-react-stage-3.js",
    "react:stage4:audit": "node scripts/verify-react-stage-4.js",
    "react:stage5:audit": "node scripts/verify-react-stage-5.js",
    "react:stage6:audit": "node scripts/verify-react-stage-6.js",
    "react:stage7:audit": "node scripts/verify-react-stage-7.js",
    "react:stage8:audit": "node scripts/verify-react-stage-8.js",
    "react:stage9:audit": "node scripts/verify-react-stage-9.js",
    "react:stage10:audit": "node scripts/verify-react-stage-10.js",
    "react:stage11:audit": "node scripts/verify-react-stage-11.js",
    "coverage:all": "npm run db:test:ready && NODE_NO_WARNINGS=1 jest --coverage --runInBand",
    "react:stage12:audit": "node scripts/verify-react-stage-12.js",
    "react:stage13:audit": "node scripts/verify-react-stage-13.js",
    "react:stage14:audit": "node scripts/verify-react-stage-14.js",
    "react:stage15:audit": "node scripts/verify-react-stage-15.js",
    "react:stage16:audit": "node scripts/verify-react-stage-16.js",
    "react:stage17:audit": "node scripts/verify-react-stage-17.js",
    "react:stage18:audit": "node scripts/verify-react-stage-18.js",
    "react:stage19:audit": "node scripts/verify-react-stage-19.js",
    "react:stage20:audit": "node scripts/verify-react-stage-20.js",
    "react:stage21:audit": "node scripts/verify-react-stage-21.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^4.4.3",
    "compression": "^1.7.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "cypress": "^15.14.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.3.0",
    "start-server-and-test": "^3.0.2",
    "supertest": "^7.2.2",
    "trx": "^1.5.0",
    "lighthouse": "^12.8.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^7.3.0"
  }
}
