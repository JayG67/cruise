DATABASE_URL=postgres://postgres:password@localhost:5432/cruise

# AI provider configuration. AI is disabled unless explicitly enabled.
AI_PROVIDER=disabled
AI_TIMEOUT_MS=5000
AI_MAX_ATTEMPTS=2
AI_RETRY_DELAY_MS=100
AI_MAX_CONTEXT_CHARS=120000

# OpenAI server-side configuration. Never expose this key through VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional cost-estimation inputs. Keep at zero to disable estimated cost reporting.
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0
