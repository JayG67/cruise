DATABASE_URL=postgres://postgres:password@localhost:5432/cruise

# AI provider configuration. AI is disabled unless explicitly enabled.
AI_PROVIDER=disabled
AI_TIMEOUT_MS=5000
AI_MAX_ATTEMPTS=2
AI_RETRY_DELAY_MS=100
AI_MAX_CONTEXT_CHARS=120000

# OpenAI server-side configuration. Never expose this key through VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional cost-estimation inputs. Keep at zero to disable estimated cost reporting.
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0

# Authentication. Production always requires JWT mode; demo identities are accepted only outside production.
# Use a random secret of at least 32 characters. Replace HS256 with an external OIDC/JWKS verifier in a later auth-provider slice.
CRUISE_AUTH_MODE=demo
CRUISE_JWT_SECRET=
CRUISE_JWT_ISSUER=https://identity.example.com/
CRUISE_JWT_AUDIENCE=cruise-explorer-api

# Demo/seed data is for local development and automated testing only.
# Production always disables demo data regardless of this setting.
CRUISE_DEMO_DATA_MODE=enabled

# Abuse protection. Production always enforces rate limits; this switch can enable them in local environments.
CRUISE_RATE_LIMIT_MODE=disabled
# General API requests per authenticated principal/IP in 15 minutes.
CRUISE_API_RATE_LIMIT=600
# POST/PUT/PATCH/DELETE requests per authenticated principal/IP in 15 minutes.
CRUISE_MUTATION_RATE_LIMIT=180
# AI requests per authenticated principal/IP per hour.
CRUISE_AI_RATE_LIMIT=30
